# Polish translations for the player submission form.
# First draft - have a native-speaking player review game terms.
# TrueGold item names are kept in English; replace them with the in-game names if they differ.
msgid ""
msgstr ""
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#, python-format
msgid "Submit for %(name)s"
msgstr "Zgłoszenie: %(name)s"

