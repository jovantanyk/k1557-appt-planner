msgstr "Spieler-ID (nur Ziffern)"

#, python-format
msgid "e.g. %(example)s"
msgstr "z. B. %(example)s"

msgid "Avatar"
msgstr "Avatar"

msgid "Player Name"
msgstr "Spielername"

msgid "Alliance"
msgstr "Allianz"

msgid "Backpack Screenshot (Optional)"
msgstr "Screenshot des Rucksacks (optional)"

msgid "Upload a screenshot of your backpack to help verify your resources."
