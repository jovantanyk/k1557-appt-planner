msgstr "Ortszeit"

msgid "Local"
msgstr "Lokal"

#, python-format
msgid "0 to %(max)s applicants (great chance of assignment)"
msgstr "0 bis %(max)s Bewerber (gute Chance auf Zuteilung)"

#, python-format
msgid "%(min)s to %(max)s applicants (moderate competition)"
msgstr "%(min)s bis %(max)s Bewerber (mäßige Konkurrenz)"

#, python-format
msgid "%(min)s+ applicants (peak competition)"
msgstr "%(min)s+ Bewerber (höchste Konkurrenz)"

#, python-format
msgid "Low (0-%(max)s)"
msgstr "Niedrig (0-%(max)s)"

#, python-format
msgid "Moderate (%(min)s-%(max)s)"
msgstr "Mittel (%(min)s-%(max)s)"

#, python-format
msgid "High (%(min)s+)"
msgstr "Hoch (%(min)s+)"

msgid "Low"
msgstr "Niedrig"

msgid "Moderate"
msgstr "Mittel"

msgid "High"
msgstr "Hoch"

#, python-format
msgid "Applicants: %(count)s"
msgstr "Bewerber: %(count)s"

#, python-format
msgid "Demand: %(level)s"
msgstr "Nachfrage: %(level)s"

