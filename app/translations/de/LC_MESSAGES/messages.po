msgstr "Tag %(num)s: Truppenausbildung"

msgid "Enter resources and select <strong>all feasible</strong> time slots. More slots give the system more flexibility to match you."
msgstr "Gib deine Ressourcen ein und wähle <strong>alle möglichen</strong> Zeitfenster aus. Je mehr Zeitfenster du wählst, desto flexibler kann das System dich einteilen."

msgid "Speedups"
msgstr "Beschleunigungen"

msgid "Days"
msgstr "Tage"

msgid "Hours"
msgstr "Stunden"

msgid "Minutes"
msgstr "Minuten"

msgid "TrueGold"
msgstr "Echtgold"

msgid "Tempered TrueGold"
msgstr "Gehärtetes Echtgold"

msgid "TrueGold Dust"
msgstr "Echtgoldstaub"

