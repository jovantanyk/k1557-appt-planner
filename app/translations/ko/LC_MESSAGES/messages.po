#, python-format
msgid "%(min)s+ applicants (peak competition)"
msgstr "신청자 %(min)s명 이상 (경쟁 치열)"

#, python-format
msgid "Low (0-%(max)s)"
msgstr "낮음 (0-%(max)s)"

#, python-format
msgid "Moderate (%(min)s-%(max)s)"
msgstr "보통 (%(min)s-%(max)s)"

#, python-format
msgid "High (%(min)s+)"
msgstr "높음 (%(min)s+)"

msgid "Low"
msgstr "낮음"

msgid "Moderate"
msgstr "보통"

msgid "High"
msgstr "높음"

#, python-format
