# Korean translations for the player submission form.
# First draft - have a native-speaking player review game terms.
# TrueGold item names are kept in English; replace them with the in-game names if they differ.
msgid ""
msgstr ""
"Language: ko\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#, python-format
msgid "Submit for %(name)s"
msgstr "신청: %(name)s"

msgid "Submission Form"
msgstr "신청서"

#, python-format
msgid "Kingdom #%(id)s"
msgstr "왕국 #%(id)s"

msgid "Language"
msgstr "언어"

msgid "Your Information"
msgstr "내 정보"

msgid "Player ID (Numeric)"
msgstr "플레이어 ID (숫자)"

