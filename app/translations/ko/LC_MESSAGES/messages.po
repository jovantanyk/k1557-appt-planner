msgstr "시간"

msgid "Minutes"
msgstr "분"

msgid "TrueGold"
msgstr "TrueGold"

msgid "Tempered TrueGold"
msgstr "Tempered TrueGold"

msgid "TrueGold Dust"
msgstr "TrueGold Dust"

