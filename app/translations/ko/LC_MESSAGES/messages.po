msgstr "올바른 플레이어 이름을 입력하세요."

msgid "Please enter resource data for at least one event day."
msgstr "최소 하나의 이벤트 날짜에 자원을 입력하세요."

#, python-format
msgid "You must select at least one time slot for: %(days)s"
msgstr "다음 날짜에 최소 하나의 시간대를 선택해야 합니다: %(days)s"

