msgstr "모두 제출"

msgid "Fetching..."
msgstr "조회 중..."

msgid "Found!"
msgstr "찾았습니다!"

msgid "Not found (manual entry enabled)"
msgstr "찾을 수 없음 (직접 입력 가능)"

